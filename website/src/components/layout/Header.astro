---
import { Icon } from 'astro-icon/components'
import { config } from '@/config'
import { withBase } from '@utils/url'

interface Props {
  class?: string
}

const className = Astro.props.class
---

<div id="navbar" class="z-50 px-4">
  <div class="absolute h-8 left-0 right-0 -top-8 bg-transparent transition"></div> <!-- used for onload animation -->
  <div class:list={[
    className,
    "!overflow-visible max-w-[var(--page-width)] h-[3.5rem] !rounded-t-none mx-auto flex items-center justify-between"]
  }>
    <div class="flex-grow basis-0">
      <a href={withBase("/")} class="rounded-lg h-[3.25rem] px-5 font-bold text-90 preserve-color">
        <div class="flex flex-row font-bold items-center text-md gap-2">
          <img src={withBase("/assets/logo.svg")} alt="" width="20" height="20" class="w-5 h-5" />
          {config.title}
        </div>
      </a>
    </div>

    <div class="flex flex-grow basis-0 justify-end">
      <!-- Theme toggle with CSS hover effects -->
      <button
        aria-label="Toggle dark mode"
        id="theme-toggle"
        class="relative rounded-md h-11 w-11 active:scale-90 flex items-center justify-center"
        onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')"
      >
        <div class="absolute transition-all duration-300 transform opacity-100 dark:opacity-0 dark:scale-75 dark:rotate-90">
          <Icon name="material-symbols:wb-sunny-outline-rounded" class="text-[1.25rem]" />
        </div>
        <div class="absolute transition-all duration-300 transform opacity-0 scale-75 rotate-90 dark:opacity-100 dark:scale-100 dark:rotate-0">
          <Icon name="material-symbols:dark-mode-outline-rounded" class="text-[1.25rem]" />
        </div>
      </button>
    </div>
  </div>
</div>
